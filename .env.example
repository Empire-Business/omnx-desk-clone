# ===========================================
# OMNX Desk — Variáveis de ambiente
# ===========================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commit o .env (ele já está no .gitignore).

# Nome exibido no app (sobrescrito pelo tenant em runtime quando logado)
VITE_APP_NAME=OMNX Desk

# Supabase (pegue em Settings → API do seu projeto)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL pública do site (Vercel em produção; localhost em dev)
# Usada nos redirects pós-login do Supabase Auth.
VITE_SITE_URL=http://localhost:5173

# Quem assina o rodapé das páginas públicas (opcional)
VITE_APP_EMPRESA=

# ── Serviços de fora (ver docs/INSTALACAO-DO-ZERO.md e src/config/recursos.ts) ──
# Central do High Ticket AI. Vazio = desligado (o token de sessão não sai do app).
VITE_HTAI_CENTRAL_URL=
# Botão "Entrar com High Ticket AI" (provedor do Supabase Auth). Vazio = escondido.
VITE_HTAI_LOGIN_PROVIDER=
# Reuniões por vídeo e resumo por IA (funções fora deste repositório). off/on.
VITE_REUNIAO_VIDEO=off
VITE_REUNIAO_RESUMO_IA=off
# Entregas da Cami (integração interna da empresa). off na instalação do zero.
VITE_CAMI_ENTREGAS=off
